{
  "manifest_version": 3,
  "name": "Chess.com cheat (Chrome extension)",
  "version": "1.4.1",
  "description": "Local Stockfish move suggestions and optional automatic moves on Chess.com boards.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "offscreen",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Knight Pilot settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
